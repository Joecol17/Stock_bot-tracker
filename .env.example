# Environment Configuration Template
# Copy this file and set your actual values
# Then set as environment variables before running the system

# ============================================================================
# TRADING 212 CONFIGURATION (Required)
# ============================================================================

# Your Trading 212 API Key and Secret
# Get both from the Trading 212 app: Settings → API
# Authentication uses HTTP Basic Auth (Base64 of "key:secret") — both are required
# CRITICAL: Keep these secret! Never share or commit to version control
TRADING212_API_KEY=your_actual_api_key_here
TRADING212_API_SECRET=your_actual_api_secret_here

# Use Demo/Practice Account (Highly Recommended)
# true  = Demo account (virtual funds, safe for testing)
# false = Live account (real money, use with caution)
TRADING212_DEMO_MODE=true

# ============================================================================
# OLLAMA CONFIGURATION
# ============================================================================

# Ollama model to use for decision making
# Popular options: llama2, mistral, neural-chat, orca-mini
# Install with: ollama pull llama2
OLLAMA_MODEL=llama2

# Temperature: Controls decision randomness (0.0 - 1.0)
# 0.0   = Always same decision (deterministic)
# 0.5   = Balanced
# 1.0   = Completely random
# Recommendation for trading: 0.2 (consistent decisions)
OLLAMA_TEMPERATURE=0.2

# Maximum tokens in response
# Higher = longer responses, uses more resources
# Typical range: 256-1024
OLLAMA_MAX_TOKENS=256

# ============================================================================
# TRADING PARAMETERS
# ============================================================================

# Number of shares to trade per order
# Recommendation: Start with 1 for testing
DEFAULT_TRADE_QUANTITY=1

# Maximum trades allowed per day (safety limit)
# Prevents runaway bot
MAX_DAILY_TRADES=10

# Minimum account value to continue trading
# Stops trading if account falls below this
MIN_ACCOUNT_VALUE=100

# ============================================================================
# HOW TO USE THIS FILE
# ============================================================================

# Option 1: Manual Environment Variables (Windows PowerShell)
# $env:TRADING212_API_KEY = "your_actual_api_key"
# $env:TRADING212_DEMO_MODE = "true"
# $env:OLLAMA_MODEL = "llama2"

# Option 2: Permanent Environment Variables (Windows)
# 1. Right-click "This PC" → Properties
# 2. Click "Advanced system settings"
# 3. Click "Environment Variables"
# 4. Click "New" under User variables
# 5. Variable name: TRADING212_API_KEY
#    Variable value: your_actual_api_key
# 6. Click OK and restart terminal

# Option 3: Python Script
# import os
# os.environ['TRADING212_API_KEY'] = 'your_api_key'
# os.environ['TRADING212_DEMO_MODE'] = 'true'

# ============================================================================
# VERIFICATION CHECKLIST
# ============================================================================

# Before running the system, verify:
# ✓ TRADING212_API_KEY is set
# ✓ TRADING212_DEMO_MODE is 'true' for testing
# ✓ Ollama is installed: ollama --version
# ✓ Ollama model is downloaded: ollama list
# ✓ Ollama server is running: ollama serve

# ============================================================================
# SECURITY NOTES
# ============================================================================

# NEVER:
# - Commit TRADING212_API_KEY to version control
# - Share your API key
# - Post API key in logs or debug output
# - Use live mode until fully tested

# ALWAYS:
# - Test in demo mode first
# - Keep backups of API credentials
# - Validate decisions before executing
# - Monitor trades actively
