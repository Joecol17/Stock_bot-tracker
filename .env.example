# Environment Configuration Template
# Copy this file and set your actual values
# Then set as environment variables before running the system

# ============================================================================
# TRADING 212 CONFIGURATION (Required)
# ============================================================================

# Your Trading 212 API Key
# Get this from: https://trading212.com/api
# CRITICAL: Keep this secret! Never share or commit to version control
TRADING212_API_KEY=your_actual_api_key_here

# Use Demo/Practice Account (Highly Recommended)
# true  = Demo account (virtual funds, safe for testing)
# false = Live account (real money, use with caution)
TRADING212_DEMO_MODE=true

# ============================================================================
# OLLAMA CONFIGURATION
# ============================================================================

# Ollama model to use for decision making
# Popular options: llama2, mistral, neural-chat, orca-mini
# Install with: ollama pull llama2
OLLAMA_MODEL=llama2

# Temperature: Controls decision randomness (0.0 - 1.0)
# 0.0   = Always same decision (deterministic)
# 0.5   = Balanced
# 1.0   = Completely random
# Recommendation for trading: 0.2 (consistent decisions)
OLLAMA_TEMPERATURE=0.2

# Maximum tokens in response
# Higher = longer responses, uses more resources
# Typical range: 256-1024
OLLAMA_MAX_TOKENS=256

# ============================================================================
# TRADING PARAMETERS
# ============================================================================

# Number of shares to trade per order
# Recommendation: Start with 1 for testing
DEFAULT_TRADE_QUANTITY=1

# Maximum trades allowed per day (safety limit)
# Prevents runaway bot
MAX_DAILY_TRADES=10

# Minimum account value to continue trading
# Stops trading if account falls below this
MIN_ACCOUNT_VALUE=100

# Stop-loss / take-profit percentages (as decimals)
# e.g. 0.03 = 3%, 0.05 = 5%
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.05

# ============================================================================
# NOTIFICATIONS (Optional)
# ============================================================================

# Discord webhook URLs — one per channel for multi-channel routing.
# How to create a webhook:
#   1. Open Discord → go to the channel → Edit Channel → Integrations → Webhooks
#   2. Click "New Webhook" → copy the URL → paste below
#
# Recommended server layout:
#   #trades       — BUY / SELL executions with AI reasoning
#   #risk-exits   — Stop-loss and take-profit triggers with P&L
#   #portfolio    — End-of-cycle account snapshots
#   #discovery    — New stocks auto-added to watchlist
#   #alerts       — Errors, bot start/stop, daily limit warnings
#
# DISCORD_WEBHOOK_URL is a fallback — used for any channel not explicitly set.
# Set only this one URL to receive all notifications in a single channel.

DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_TRADES=
DISCORD_WEBHOOK_RISK=
DISCORD_WEBHOOK_PORTFOLIO=
DISCORD_WEBHOOK_DISCOVERY=
DISCORD_WEBHOOK_ALERTS=

# ============================================================================
# REMOTE / HEADLESS OPERATION (Optional)
# ============================================================================

# Shut the PC down automatically 2 minutes after the bot finishes its daily cycle.
# Great for saving electricity when you only need the bot for ~30-60 min per day.
BOT_AUTO_SHUTDOWN=false

# Remote dashboard login — set all three to enable username/password protection.
# Leave all three blank for open/local-network access.
#
# Anyone who reaches your Cloudflare tunnel URL will see a login screen and
# must enter the correct username + password before they can view any data
# or trigger any actions.
#
# DASHBOARD_SECRET becomes the bearer token after a successful login.
# Pick a long random string (e.g. output of: python -c "import secrets; print(secrets.token_hex(32))")
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DASHBOARD_SECRET=

# Bot cycle interval in seconds (default 86400 = 24 hours, once per day)
BOT_CYCLE_INTERVAL=86400

# ============================================================================
# SWING TRADING PARAMETERS (Optional — safe to leave at defaults)
# ============================================================================

# Risk per trade as a fraction of portfolio (0.01 = 1%)
RISK_PER_TRADE_PCT=0.01

# ATR stop-loss multiplier (stop = entry - ATR × this)
ATR_STOP_MULTIPLIER=1.5

# Minimum risk:reward ratio — skip trade if target < this × risk (2.0 = 2:1 R:R)
MIN_RISK_REWARD=2.0

# Maximum single-position size as a fraction of portfolio (0.10 = 10%)
MAX_POSITION_PCT=0.10

# Flag trade for review after N calendar days
MAX_HOLD_DAYS=10

# Skip a symbol if earnings are within N days
EARNINGS_BUFFER_DAYS=5

# Minimum relative strength vs SPY (1.0 = parity, 0.95 = 5% below SPY is OK)
MIN_RELATIVE_STRENGTH=0.95

# Minimum number of pre-trade filters that must pass (out of 4) before LLM runs
MIN_FILTER_SCORE=2

# Block ALL buys during bear regime (true = stricter, false = only warn)
REGIME_STRICT=false

# ============================================================================
# WATCHLIST / DISCOVERY (Optional)
# ============================================================================

# Path to watchlist JSON file (default: watchlist.json in project root)
WATCHLIST_FILE=watchlist.json

# Max symbols to analyse per bot cycle (screener picks the best ones)
MAX_SYMBOLS_PER_CYCLE=5

# How often to run stock discovery (every N cycles)
DISCOVERY_INTERVAL_CYCLES=6

# How many new stocks to add per discovery run
DISCOVERY_TOP_N=10

# Maximum watchlist size (discovery won't add beyond this)
MAX_WATCHLIST_SIZE=20

# ============================================================================
# HOW TO USE THIS FILE
# ============================================================================

# Option 1: Manual Environment Variables (Windows PowerShell)
# $env:TRADING212_API_KEY = "your_actual_api_key"
# $env:TRADING212_DEMO_MODE = "true"
# $env:OLLAMA_MODEL = "llama2"

# Option 2: Permanent Environment Variables (Windows)
# 1. Right-click "This PC" → Properties
# 2. Click "Advanced system settings"
# 3. Click "Environment Variables"
# 4. Click "New" under User variables
# 5. Variable name: TRADING212_API_KEY
#    Variable value: your_actual_api_key
# 6. Click OK and restart terminal

# Option 3: Python Script
# import os
# os.environ['TRADING212_API_KEY'] = 'your_api_key'
# os.environ['TRADING212_DEMO_MODE'] = 'true'

# ============================================================================
# VERIFICATION CHECKLIST
# ============================================================================

# Before running the system, verify:
# ✓ TRADING212_API_KEY is set
# ✓ TRADING212_DEMO_MODE is 'true' for testing
# ✓ Ollama is installed: ollama --version
# ✓ Ollama model is downloaded: ollama list
# ✓ Ollama server is running: ollama serve

# ============================================================================
# SECURITY NOTES
# ============================================================================

# NEVER:
# - Commit TRADING212_API_KEY to version control
# - Share your API key
# - Post API key in logs or debug output
# - Use live mode until fully tested

# ALWAYS:
# - Test in demo mode first
# - Keep backups of API credentials
# - Validate decisions before executing
# - Monitor trades actively
